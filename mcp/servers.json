{
  "mcpServers": {
    "Figma": {
      "enabled": false,
      "type": "http",
      "url": "https://mcp.figma.com/mcp",
      "headers": {}
    },
    "next-devtools": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "next-devtools-mcp@latest"
      ]
    },
    "playwright": {
      "enabled": true,
      "type": "stdio",
      "command": "/Users/shun.tagami/dotfiles/bin/playwright-mcp",
      "args": [],
      "codex": {
        "tools": {
          "browser_click": {
            "approval_mode": "auto"
          },
          "browser_navigate": {
            "approval_mode": "auto"
          },
          "browser_run_code_unsafe": {
            "approval_mode": "auto"
          }
        }
      }
    },
    "screenpipe": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "screenpipe-mcp"
      ]
    },
    "notion": {
      "enabled": false,
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "supabase": {
      "enabled": true,
      "type": "stdio",
      "command": "/Users/shun.tagami/dotfiles/mcp/run-supabase-mcp.sh"
    },
    "slack": {
      "enabled": true,
      "clients": [
        "antigravity"
      ],
      "type": "http",
      "url": "https://mcp.slack.com/mcp",
      "headersFromKeychain": {
        "Authorization": {
          "service": "Slack MCP",
          "account": "user-token",
          "prefix": "Bearer "
        }
      }
    }
  }
}
