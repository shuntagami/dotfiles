#!/usr/bin/env bash
# post-checkout hook, installed globally via core.hooksPath (see .gitconfig).
#
# Backfills gitignored, untracked .env files into a brand-new git worktree.
# `git worktree add` only checks out tracked files, so .env, .env.local and
# .env.<anything> files at any depth would otherwise be missing there.
#
# Keep this hook local-only and quick. Updating remotes belongs before a
# worktree is cut (and in the caller that can show progress), not in a hidden
# post-checkout step where it cannot affect the worktree just created.
#
# Fires for EVERY `git worktree add`, whichever tool called it: MulmoTerminal's
# plus-button worktree creation, `git wl`/`git wd`/etc, or a bare
# `git worktree add` typed by hand - because it runs at the git layer, below
# all of them.
#
# git passes an all-zero SHA as $1 only when there was no previous HEAD in
# this working tree - true for a brand-new worktree or a fresh clone, never
# for an ordinary branch switch in an existing one. That is the only signal
# this hook acts on.
#
# Do not use `set -e`: copying an optional local file must not turn a worktree
# that Git successfully created into an apparent failure. Report individual
# copy failures and leave the created tree usable.
set -u

prev_head="${1:-}"
[[ "$prev_head" == "0000000000000000000000000000000000000000" ]] || exit 0

main_worktree=$(git worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' | head -n 1) || exit 0
[[ -n "$main_worktree" ]] || exit 0

dest_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[[ "$main_worktree" != "$dest_root" ]] || exit 0
[[ -d "$main_worktree" ]] || exit 0

copied=0
skipped=0
failed=0
while IFS= read -r -d '' envfile; do
  rel="${envfile#"$main_worktree"/}"
  [[ "$rel" != "$envfile" ]] || continue

  # A tracked `.env.example` may match the filename pattern but is already
  # checked out by Git. Copy only files Git itself says are ignored.
  git -C "$main_worktree" check-ignore --quiet -- "$rel" 2>/dev/null || continue

  dest="$dest_root/$rel"
  if [[ -e "$dest" || -L "$dest" ]]; then
    skipped=$((skipped + 1))
    continue
  fi
  if mkdir -p "$(dirname "$dest")" && cp -p "$envfile" "$dest"; then
    copied=$((copied + 1))
  else
    failed=$((failed + 1))
    printf '[post-checkout] could not copy %s into %s\n' "$rel" "$dest_root" >&2
  fi
done < <(find "$main_worktree" \
    \( -name node_modules -o -name .git -o -name dist -o -name build \
       -o -name .next -o -name target -o -name vendor -o -name .venv \) -prune -o \
    -type f \( -name '.env' -o -name '.env.*' \) -print0)

if (( copied > 0 )); then
  echo "[post-checkout] copied $copied .env file(s) into $dest_root" >&2
fi
if (( skipped > 0 )); then
  echo "[post-checkout] kept $skipped existing .env file(s) in $dest_root" >&2
fi
if (( failed > 0 )); then
  echo "[post-checkout] $failed .env file(s) could not be copied; the worktree itself is ready" >&2
fi

exit 0
