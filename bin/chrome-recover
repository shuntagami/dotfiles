#!/usr/bin/env python3
"""Stop this user's headless Chrome instances, then open normal Chrome on macOS."""
import argparse
import os
import signal
import subprocess
import time

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--dry-run', action='store_true', help='Show targets without stopping or opening Chrome')
args = parser.parse_args()
chrome = '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'


def targets():
    output = subprocess.check_output(
        ['/bin/ps', '-U', str(os.getuid()), '-o', 'pid=,command='], text=True)
    found = set()
    for line in output.splitlines():
        parts = line.strip().split(None, 1)
        if len(parts) != 2 or not parts[1].startswith(chrome + ' '):
            continue
        flags = parts[1][len(chrome):].split()
        if any(x == '--headless' or x.startswith('--headless=') for x in flags):
            found.add(int(parts[0]))
    return found


def stop(pids, sig):
    for pid in sorted(pids & targets()):
        try:
            os.kill(pid, sig)
        except ProcessLookupError:
            pass


if not os.path.isfile(chrome):
    parser.exit(1, 'Google Chrome is not installed in /Applications.\n')
pids = targets()
print('Headless Chrome PIDs:', ', '.join(map(str, sorted(pids))) or 'none', flush=True)
if args.dry_run:
    raise SystemExit(0)
stop(pids, signal.SIGTERM)
deadline = time.monotonic() + 5
while pids & targets() and time.monotonic() < deadline:
    time.sleep(0.2)
stop(pids, signal.SIGKILL)
subprocess.run(['/usr/bin/open', '-a', 'Google Chrome'], check=True)
print('Opened Google Chrome. Normal browser windows and profile files were left intact.')
