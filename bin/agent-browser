#!/usr/bin/env python3
"""Connect agents to an existing Chrome profile; never launch another browser."""
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import socket
import subprocess
import sys

DEFAULT_HOST = "shun-tagami-mac-mini"
MCP_PACKAGE = "@playwright/mcp@0.0.82"
EXTENSION_ID = "mmlmfjhmonkocbjadbfplnigmagldckm"
EXTENSION_URL = "https://chromewebstore.google.com/detail/playwright-extension/" + EXTENSION_ID
CHROME = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
LAUNCH_OPTIONS = {
    "--cdp-endpoint", "--endpoint", "--user-data-dir", "--executable-path",
    "--isolated", "--headless", "--browser", "--extension", "--port", "--host", "--config",
}
LAUNCH_ENV = {
    "PLAYWRIGHT_MCP_CDP_ENDPOINT", "PLAYWRIGHT_MCP_ENDPOINT",
    "PLAYWRIGHT_MCP_USER_DATA_DIR", "PLAYWRIGHT_MCP_EXECUTABLE_PATH",
    "PLAYWRIGHT_MCP_ISOLATED", "PLAYWRIGHT_MCP_HEADLESS", "PLAYWRIGHT_MCP_BROWSER",
    "PLAYWRIGHT_MCP_PORT", "PLAYWRIGHT_MCP_HOST", "PLAYWRIGHT_MCP_CONFIG",
}


class ConfigurationError(Exception):
    pass


def pause_file():
    return Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "agent-browser/paused"


def chrome_root():
    return Path.home() / "Library/Application Support/Google/Chrome"


def is_local(host):
    name = host.rsplit("@", 1)[-1].lower().split(".")[0]
    return host in ("local", "localhost", "127.0.0.1") or name == socket.gethostname().lower().split(".")[0]


def parse_options(args):
    """Prevent launcher flags or config files from overriding extension mode."""
    remaining = []
    profile = os.environ.get("PLAYWRIGHT_MCP_PROFILE_DIR_NAME")
    i = 0
    while i < len(args):
        arg = args[i]
        key = arg.split("=", 1)[0]
        if key in LAUNCH_OPTIONS:
            raise ConfigurationError(f"{key} is not supported: this connection uses existing Chrome only.")
        if key == "--profile-dir-name":
            if "=" in arg:
                profile = arg.split("=", 1)[1]
            else:
                i += 1
                if i == len(args):
                    raise ConfigurationError("--profile-dir-name needs a directory name.")
                profile = args[i]
        else:
            remaining.append(arg)
        i += 1
    if profile is not None and (not profile or Path(profile).name != profile or profile in (".", "..")):
        raise ConfigurationError("Profile must be a directory name such as 'Profile 2', not a path.")
    return profile, remaining


def selected_profile(root, explicit=None):
    try:
        profiles = json.loads((root / "Local State").read_text())["profile"]
    except (OSError, ValueError, KeyError) as exc:
        raise ConfigurationError("Cannot read normal Chrome profiles; open Chrome on the browser host first.") from exc
    directory = explicit or profiles.get("last_used")
    if not directory or Path(directory).name != directory or directory in (".", ".."):
        raise ConfigurationError("Chrome has no valid last-used profile; select a profile in Chrome first.")
    info = profiles.get("info_cache", {}).get(directory)
    if info is None or not (root / directory).is_dir():
        raise ConfigurationError(f"Chrome profile {directory!r} does not exist; no profile was created.")
    return directory, info.get("user_name", ""), info.get("name", "")


def chrome_running():
    # A second Chrome using --user-data-dir must not satisfy this check.
    result = subprocess.run(["/bin/ps", "-axo", "uid=,command="], capture_output=True, text=True, check=True)
    for line in result.stdout.splitlines():
        parts = line.strip().split(None, 1)
        if len(parts) != 2 or parts[0] != str(os.getuid()):
            continue
        command = parts[1]
        if (command == CHROME or command.startswith(CHROME + " ")) and "--user-data-dir" not in command:
            return True
    return False


def extension_installed(root, directory):
    return any((root / directory / "Extensions" / EXTENSION_ID).glob("*/manifest.json"))


def ssh_command(host, command, profile, args):
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.@-]*", host):
        raise ConfigurationError("AGENT_BROWSER_HOST must be a local marker or an SSH host name.")
    remote_args = [command, "--local"]
    if profile:
        remote_args += ["--profile-dir-name", profile]
    remote_args += args
    remote = 'exec "$HOME/dotfiles/bin/agent-browser" ' + shlex.join(remote_args)
    return [
        "/usr/bin/ssh", "-T", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8",
        "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=2", host, remote,
    ]


def local_state(profile):
    directory, email, name = selected_profile(chrome_root(), profile)
    return {
        "browser_host": socket.gethostname(),
        "mode": "existing-chrome-extension",
        "profile_directory": directory,
        "profile_name": name,
        "account": email,
        "chrome_running": chrome_running(),
        "extension_installed": extension_installed(chrome_root(), directory),
        "paused": pause_file().exists(),
    }


def main(argv=None):
    args = list(sys.argv[1:] if argv is None else argv)
    command = args.pop(0) if args else "status"
    local = bool(args and args[0] == "--local")
    if local:
        args.pop(0)
    if command in ("pause", "resume"):
        if args:
            raise ConfigurationError(f"{command} takes no arguments and affects only this machine.")
        marker = pause_file()
        if command == "pause":
            marker.parent.mkdir(parents=True, exist_ok=True)
            marker.write_text("Existing-browser connections paused by the operator.\n")
        else:
            marker.unlink(missing_ok=True)
        print(f"agent-browser: new connections on this machine are {'paused' if command == 'pause' else 'enabled'}.", file=sys.stderr)
        return 0
    if command not in ("mcp", "status"):
        raise ConfigurationError(
            "Usage: agent-browser {status|pause|resume}. "
            "Legacy up/down/endpoint commands are retired; Chrome is no longer launched or killed."
        )
    profile, remaining = parse_options(args)
    if command == "mcp" and pause_file().exists():
        raise ConfigurationError(f"Paused ({pause_file()}); use agent-browser resume when ready.")
    host = os.environ.get("AGENT_BROWSER_HOST", DEFAULT_HOST)
    if not local and not is_local(host):
        # Keep stdio attached to SSH: no CDP port, daemon, or local fallback.
        os.execv("/usr/bin/ssh", ssh_command(host, command, profile, remaining))
    state = local_state(profile)
    if command == "status":
        print(json.dumps(state, ensure_ascii=False, indent=2))
        return 0
    if not state["chrome_running"]:
        raise ConfigurationError("Normal Chrome is not running on the browser host. Open it and retry; no browser was launched.")
    if not state["extension_installed"]:
        raise ConfigurationError(
            f"Playwright Extension is missing in {state['profile_directory']} ({state['account']}). "
            f"Install it in that profile: {EXTENSION_URL}"
        )
    environment = dict(os.environ)
    for key in LAUNCH_ENV:
        environment.pop(key, None)
    environment["PATH"] = "/opt/homebrew/bin:/usr/local/bin:" + environment.get("PATH", "/usr/bin:/bin")
    npx = shutil.which("npx", path=environment["PATH"])
    if not npx:
        raise ConfigurationError("npx is not installed on the browser host.")
    print(
        f"playwright-mcp: existing Chrome on {state['browser_host']}, "
        f"{state['profile_directory']} ({state['account']}); approve/select tabs in Chrome.",
        file=sys.stderr,
    )
    launch = [npx, "-y", MCP_PACKAGE, "--extension", "--browser", "chrome",
              "--profile-dir-name", state["profile_directory"], *remaining]
    os.execvpe(npx, launch, environment)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (ConfigurationError, OSError, subprocess.SubprocessError) as exc:
        print(f"agent-browser: {exc}", file=sys.stderr)
        sys.exit(1)
