#!/usr/bin/env -S deno run -A --ext=js
// 画像フォルダを1枚1枚スライドに貼り込んだPPTXを作る。
// PDF→画像化した資料をGoogleスライドで開きたい時などに使う。
//
// Usage:
//   images-to-pptx [options] <image_dir> [output.pptx]
//
// Options:
//   -p, --preset <name>     original|high|medium|low (default: medium)
//   -q, --quality <0-100>   JPEG品質 (sipsのformatOptions値, presetを上書き)
//   -w, --width <px>        リサイズ後の最大幅 (presetを上書き)
//   -h, --help              このヘルプを表示
//
// プリセット:
//   original  リサイズ・再エンコードなし。元画像をそのまま埋め込む(劣化ゼロ、最大サイズ)
//   high      quality=90, width=1920
//   medium    quality=65, width=1280 (default, 旧デフォルトと同じ)
//   low       quality=45, width=960  (最小サイズ)
//
// output.pptx を省略すると <image_dir>.pptx (image_dirと同じ階層) に保存する。
//
// 実装メモ: リサイズ・JPEG変換はmacOS標準のsipsで行い、PPTX組み立てはpptxgenjs
// (npm:, Denoのグローバルキャッシュ経由でrepo非依存) を使う。Pythonは使わない。
// originalプリセットはsips変換自体をスキップして元ファイルを直接埋め込む
// (quality=100でのJPEG再エンコードもPNG→JPEG変換も非可逆なため)。

import pptxgen from "npm:pptxgenjs@3.12.0";
import { readdirSync, mkdtempSync, rmSync, existsSync } from "node:fs";
import { join, resolve } from "node:path";
import { tmpdir } from "node:os";
import { execFileSync } from "node:child_process";

const PRESETS = {
  original: { quality: null, width: null },
  high: { quality: 90, width: 1920 },
  medium: { quality: 65, width: 1280 },
  low: { quality: 45, width: 960 },
};

function showHelp() {
  console.log(`Usage: images-to-pptx [options] <image_dir> [output.pptx]

Options:
  -p, --preset <name>     original|high|medium|low (default: medium)
  -q, --quality <0-100>   JPEG quality via sips (overrides preset)
  -w, --width <px>        Max image width in px (overrides preset)
  -h, --help              Show this help

Presets:
  original  No resize/re-encode, embeds source files as-is (zero quality loss, largest file)
  high      quality=90, width=1920
  medium    quality=65, width=1280 (default, same as the old fixed defaults)
  low       quality=45, width=960  (smallest file)
`);
}

const rawArgs = [...Deno.args];
let presetName = "medium";
let quality = null;
let width = null;
let qualityExplicit = false;
let widthExplicit = false;
const positional = [];

while (rawArgs.length > 0) {
  const arg = rawArgs.shift();
  if (arg === "-h" || arg === "--help") {
    showHelp();
    Deno.exit(0);
  } else if (arg === "-p" || arg === "--preset") {
    presetName = rawArgs.shift();
  } else if (arg === "-q" || arg === "--quality") {
    quality = parseInt(rawArgs.shift(), 10);
    qualityExplicit = true;
  } else if (arg === "-w" || arg === "--width") {
    width = parseInt(rawArgs.shift(), 10);
    widthExplicit = true;
  } else {
    positional.push(arg);
  }
}

if (!(presetName in PRESETS)) {
  console.error(`Error: unknown preset "${presetName}" (expected: ${Object.keys(PRESETS).join("|")})`);
  Deno.exit(1);
}

const useOriginal = presetName === "original";
if (useOriginal && (qualityExplicit || widthExplicit)) {
  console.error("Warning: --quality/--width are ignored with --preset original (no re-encode happens).");
}
if (!qualityExplicit) quality = PRESETS[presetName].quality;
if (!widthExplicit) width = PRESETS[presetName].width;

if (positional.length === 0) {
  showHelp();
  Deno.exit(1);
}

const imageDir = resolve(positional[0]);
const outputPath = positional[1] ? resolve(positional[1]) : `${imageDir}.pptx`;

if (!existsSync(imageDir)) {
  console.error(`Error: directory not found: ${imageDir}`);
  Deno.exit(1);
}

try {
  execFileSync("sips", ["--version"], { stdio: "ignore" });
} catch {
  console.error("Error: sips not found (this command requires macOS).");
  Deno.exit(1);
}

const images = readdirSync(imageDir)
  .filter((f) => /\.(png|jpe?g)$/i.test(f))
  .sort()
  .map((f) => join(imageDir, f));

if (images.length === 0) {
  console.error(`Error: no images found in ${imageDir}`);
  Deno.exit(1);
}

function sipsDims(path) {
  const out = execFileSync("sips", ["-g", "pixelWidth", "-g", "pixelHeight", path], { encoding: "utf8" });
  const w = parseInt(out.match(/pixelWidth: (\d+)/)[1], 10);
  const h = parseInt(out.match(/pixelHeight: (\d+)/)[1], 10);
  return { w, h };
}

const { w: w0, h: h0 } = sipsDims(images[0]);
const slideWidthIn = 13.333;
const slideHeightIn = (slideWidthIn * h0) / w0;

const tmp = mkdtempSync(join(tmpdir(), "images-to-pptx-"));

const p = new pptxgen();
p.defineLayout({ name: "CUSTOM", width: slideWidthIn, height: slideHeightIn });
p.layout = "CUSTOM";

let i = 0;
for (const imgPath of images) {
  i++;
  let slideImgPath = imgPath;

  if (!useOriginal) {
    const outJpg = join(tmp, `slide-${String(i).padStart(3, "0")}.jpg`);
    const sipsArgs = ["-s", "format", "jpeg", "-s", "formatOptions", String(quality ?? 65)];
    if (width != null) sipsArgs.push("-Z", String(width));
    sipsArgs.push(imgPath, "--out", outJpg);
    execFileSync("sips", sipsArgs, { stdio: "ignore" });
    slideImgPath = outJpg;
  }

  const slide = p.addSlide();
  slide.addImage({ path: slideImgPath, x: 0, y: 0, w: slideWidthIn, h: slideHeightIn });
}

await p.writeFile({ fileName: outputPath });
rmSync(tmp, { recursive: true, force: true });
console.log(`${images.length} slides -> ${outputPath}`);
