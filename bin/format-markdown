var DOCS_SPACER_LINE = "\u3164";
var DOCS_TABLE_SPACER_CELL = DOCS_SPACER_LINE;
var injectTableHeadingSpacer = (md) => {
  const lines = md.split("\n");
  const result = [];
  const tableColumnCountFromLine = (line) => {
    const trimmed = line.trim();
    const separators = (trimmed.match(/\|/g) ?? []).length;
    return separators > 1 ? separators - 1 : 1;
  };
  const buildDocsSpacerRow = (columnCount) => {
    const cells = Array.from({
      length: columnCount
    }, (_value, index) => index === 0 ? ` ${DOCS_TABLE_SPACER_CELL} ` : " ");
    return `|${cells.join("|")}|`;
  };
  for (const line of lines) {
    const headingMatch = line.match(/^(#{1,6})\s/);
    if (headingMatch) {
      const headingHashes = headingMatch[1];
      const prevNonEmpty = [
        ...result
      ].reverse().find((candidate) => candidate.trim() !== "");
      const lastLine = result[result.length - 1] ?? "";
      const beforeLastLine = result[result.length - 2] ?? "";
      if (prevNonEmpty && /^\|/.test(prevNonEmpty) && lastLine === "" && beforeLastLine !== DOCS_SPACER_LINE) {
        const columnCount = tableColumnCountFromLine(prevNonEmpty);
        const spacerRow = buildDocsSpacerRow(columnCount);
        const spacerHeading = `${headingHashes} ${DOCS_SPACER_LINE}`;
        result.splice(result.length - 1, 0, spacerRow);
        result.push(spacerHeading);
        result.push("");
      }
    }
    result.push(line);
  }
  return result.join("\n");
};
var stripDocsSpacerArtifacts = (md) => md.replace(/^\|\s*ㅤ\s*\|(?:\s*\|)*\s*$/gm, "").replace(/^#{1,6}\s+ㅤ\s*$/gm, "").replace(/\n{3,}/g, "\n\n");
var FULL_WIDTH_CHAR_PATTERN = "(?:\\p{Script=Hiragana}|\\p{Script=Katakana}|\\p{Script=Han}|[\\u3000-\\u303f\\uff00-\\uffef])";
var ASCII_TO_FW_REGEX = new RegExp(`([A-Za-z0-9]) +(${FULL_WIDTH_CHAR_PATTERN})`, "gu");
var FW_TO_ASCII_REGEX = new RegExp(`(${FULL_WIDTH_CHAR_PATTERN}) +([A-Za-z0-9])`, "gu");
var stripAsciiCjkSpaces = (md) => {
  const processLine = (line) => {
    const codeSpans = [];
    const masked = line.replace(/`+[^`\n]*?`+/g, (match) => {
      const idx = codeSpans.length;
      codeSpans.push(match);
      return `\uE000${idx}\uE001`;
    });
    const replaced = masked.replace(ASCII_TO_FW_REGEX, "$1$2").replace(FW_TO_ASCII_REGEX, "$1$2");
    return replaced.replace(/(\d+)/g, (_match, idx) => codeSpans[Number(idx)] ?? _match);
  };
  const lines = md.split("\n");
  let inCodeBlock = false;
  return lines.map((line) => {
    if (line.trim().startsWith("```")) {
      inCodeBlock = !inCodeBlock;
      return line;
    }
    if (inCodeBlock) return line;
    return processLine(line);
  }).join("\n");
};
var stripZwsp = (md) => stripDocsSpacerArtifacts(md).split("\n").map((line) => {
  if (line === DOCS_SPACER_LINE) return line;
  const withoutZwsp = line.replace(/\u200B+$/g, "");
  if (isAutoBreakLine(withoutZwsp)) return withoutZwsp;
  return withoutZwsp.replace(/ {2}$/, "");
}).join("\n");
var parseMarkdownBlocks = (md) => {
  const lines = stripZwsp(stripAsciiCjkSpaces(md)).split("\n");
  const blocks = [];
  let prevLineType = "empty";
  let inCodeBlock = false;
  let paragraphId = 0;
  const pushLine = (content) => {
    blocks.push({
      tag: "line",
      content
    });
  };
  for (const line of lines) {
    if (line.trim().startsWith("```")) {
      inCodeBlock = !inCodeBlock;
      if (!inCodeBlock && prevLineType !== "empty") pushLine("");
      pushLine(line);
      prevLineType = "code";
      continue;
    }
    if (inCodeBlock) {
      pushLine(line);
      prevLineType = "code";
      continue;
    }
    if (line.trim() === "") {
      pushLine("");
      prevLineType = "empty";
      continue;
    }
    if (/^#{1,6}\s/.test(line)) {
      const noBold = line.replace(/\*\*([^*]+)\*\*/g, "$1");
      if (prevLineType !== "empty" && blocks.length > 0) pushLine("");
      pushLine(noBold);
      prevLineType = "heading";
      continue;
    }
    if (/^(-{3,}|\*{3,}|_{3,})$/.test(line)) {
      continue;
    }
    if (/^(\s*)[-*+]\s/.test(line) || /^(\s*)\d+\.\s/.test(line)) {
      if (prevLineType !== "list" && prevLineType !== "empty" && blocks.length > 0) pushLine("");
      pushLine(line);
      prevLineType = "list";
      continue;
    }
    if (/^>\s?/.test(line)) {
      if (prevLineType !== "quote" && prevLineType !== "empty" && blocks.length > 0) pushLine("");
      pushLine(line);
      prevLineType = "quote";
      continue;
    }
    if (/^\|/.test(line)) {
      if (prevLineType !== "table" && prevLineType !== "empty" && blocks.length > 0) pushLine("");
      pushLine(line);
      prevLineType = "table";
      continue;
    }
    if (prevLineType !== "paragraph" && prevLineType !== "empty" && blocks.length > 0) pushLine("");
    blocks.push({
      tag: "paragraph",
      id: paragraphId++,
      text: line
    });
    prevLineType = "paragraph";
  }
  return blocks;
};
var resolveBlocks = (blocks, resolver) => {
  const result = [];
  for (const block of blocks) {
    if (block.tag === "line") {
      result.push(block.content);
    } else {
      result.push(...resolver(block.id, block.text));
    }
  }
  while (result.length > 0 && result[result.length - 1] === "") result.pop();
  return result;
};
var finalizeMarkdown = (lines) => addZwsp(injectTableHeadingSpacer(stripAsciiCjkSpaces(lines.join("\n").trimEnd())));
var AIFormattingValidationError = class extends Error {
  constructor() {
    super("AI\u304C\u672C\u6587\u3092\u5909\u66F4\u3057\u305F\u304B\u3001\u6539\u884C\u7D50\u679C\u304C\u4E0D\u8DB3\u3057\u3066\u3044\u307E\u3059\u3002\u539F\u6587\u306F\u4FDD\u5B58\u3057\u305F\u307E\u307E\u518D\u5B9F\u884C\u3057\u3066\u304F\u3060\u3055\u3044");
    this.name = "AIFormattingValidationError";
  }
};
var formatMarkdownWithAI = async (md, breakParagraphs) => {
  const blocks = parseMarkdownBlocks(md);
  const paragraphs = blocks.filter((b) => b.tag === "paragraph").filter((p) => p.text.length > 40).map((p) => ({
    id: p.id,
    text: p.text
  }));
  const aiResults = paragraphs.length > 0 ? await breakParagraphs(paragraphs) : /* @__PURE__ */ new Map();
  const lines = resolveBlocks(blocks, (id, text) => {
    if (text.length <= 40) return [
      text
    ];
    const aiResult = aiResults.get(id);
    if (!aiResult?.length) throw new AIFormattingValidationError();
    return aiResult;
  });
  return finalizeMarkdown(lines);
};
var LINE_BREAK_SUFFIX = "  ";
var AUTO_BREAK_PATTERNS = [
  /^\s*$/,
  /^\s*#/,
  /^\s*[-+*]\s+/,
  /^\s*\d+\.\s+/,
  /^\s*>/,
  /^\s*```/,
  /^\s*\|/,
  /^\s*[-*_]{3,}\s*$/
];
var isAutoBreakLine = (line) => line === DOCS_SPACER_LINE || AUTO_BREAK_PATTERNS.some((re) => re.test(line));
var addZwsp = (md) => {
  const lines = md.split("\n");
  let inCodeBlock = false;
  const result = lines.map((line, index) => {
    if (line.trim().startsWith("```")) {
      inCodeBlock = !inCodeBlock;
      return line;
    }
    if (inCodeBlock) return line;
    if (isAutoBreakLine(line)) return line;
    const normalizedLine = line.replace(/\u200B+$/g, "").replace(/ {2}$/, "");
    const nextLine = lines[index + 1] ?? "";
    if (nextLine.trim() === "") return normalizedLine;
    return `${normalizedLine}${LINE_BREAK_SUFFIX}`;
  });
  return result.join("\n");
};

