// lib/markdown-format/openai.ts
var FormatterConfigurationError = class extends Error {
};
function validatedParagraphResults(originals, returned) {
  const results = /* @__PURE__ */ new Map();
  for (const paragraph of returned.paragraphs) {
    const original = originals.find((candidate) => candidate.id === paragraph.id);
    if (original && paragraph.lines.length > 0 && original.text.replace(/\s+/g, "") === paragraph.lines.join("").replace(/\s+/g, "")) {
      results.set(paragraph.id, paragraph.lines.map((line) => line.trim()));
    }
  }
  return results;
}
var resultSchema = {
  type: "object",
  properties: {
    paragraphs: {
      type: "array",
      items: {
        type: "object",
        properties: {
          id: {
            type: "integer"
          },
          lines: {
            type: "array",
            items: {
              type: "string"
            }
          }
        },
        required: [
          "id",
          "lines"
        ],
        additionalProperties: false
      }
    }
  },
  required: [
    "paragraphs"
  ],
  additionalProperties: false
};
async function processChunk(chunk, apiKey, model, signal, request) {
  const response = await request("https://api.openai.com/v1/responses", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${apiKey}`
    },
    body: JSON.stringify({
      model,
      store: false,
      instructions: MARKDOWN_FORMAT_SYSTEM_PROMPT,
      input: `\u4EE5\u4E0B\u306E\u6BB5\u843D\u30C6\u30AD\u30B9\u30C8\u3092\u6539\u884C\u3057\u3066\u304F\u3060\u3055\u3044\u3002

${JSON.stringify(chunk)}`,
      text: {
        format: {
          type: "json_schema",
          name: "markdown_line_breaks",
          strict: true,
          schema: resultSchema
        }
      }
    }),
    redirect: "error",
    signal
  });
  if (!response.ok) throw new Error(`OpenAI API\u30A8\u30E9\u30FC (${response.status})\u3002\u8A2D\u5B9A\u3084\u5229\u7528\u72B6\u6CC1\u3092\u78BA\u8A8D\u3057\u3066\u304F\u3060\u3055\u3044`);
  const body = await response.json();
  if (body.status !== "completed") throw new Error("AI\u306E\u5FDC\u7B54\u304C\u5B8C\u4E86\u3057\u3066\u3044\u307E\u305B\u3093\u3002\u518D\u5B9F\u884C\u3057\u3066\u304F\u3060\u3055\u3044");
  const text = (body.output ?? []).filter((item) => item.type === "message").flatMap((item) => item.content ?? []).filter((item) => item.type === "output_text").map((item) => item.text ?? "").join("");
  if (!text) throw new AIFormattingValidationError();
  const result = JSON.parse(text);
  if (!Array.isArray(result.paragraphs) || !result.paragraphs.every((paragraph) => Number.isInteger(paragraph.id) && Array.isArray(paragraph.lines) && paragraph.lines.every((line) => typeof line === "string" && line.trim().length > 0))) {
    throw new AIFormattingValidationError();
  }
  return validatedParagraphResults(chunk, result);
}
async function formatOpenAIMarkdown(markdown, options) {
  if (!markdown.trim() || markdown.length > 1e5) throw new Error("\u5165\u529B\u306F\u7A7A\u3067\u306A\u3044100000\u6587\u5B57\u4EE5\u5185\u306B\u3057\u3066\u304F\u3060\u3055\u3044");
  const timeout = AbortSignal.timeout(1e5);
  const signal = options.signal ? AbortSignal.any([
    options.signal,
    timeout
  ]) : timeout;
  return formatMarkdownWithAI(markdown, async (paragraphs) => {
    if (!options.apiKey) throw new FormatterConfigurationError("OPENAI_API_KEY \u3092\u8A2D\u5B9A\u3057\u3066\u304F\u3060\u3055\u3044");
    const results = /* @__PURE__ */ new Map();
    for (let offset = 0; offset < paragraphs.length; offset += 40) {
      const batch = paragraphs.slice(offset, offset + 40);
      const chunks = [
        batch.slice(0, 20),
        batch.slice(20)
      ].filter((chunk) => chunk.length > 0);
      const returned = await Promise.all(chunks.map((chunk) => processChunk(chunk, options.apiKey, options.model ?? "gpt-6.1-sol", signal, options.request ?? fetch)));
      for (const chunk of returned) for (const [id, lines] of chunk) results.set(id, lines);
    }
    return results;
  });
}

// cli/format-markdown.mjs
var deno = globalThis.Deno;
function parseArgs(args) {
  const options = {};
  let positional;
  let flags = true;
  for (let i = 0; i < args.length; i++) {
    const arg = args[i];
    if (flags && arg === "--") {
      flags = false;
      continue;
    }
    if (flags && ["--help", "-h"].includes(arg)) {
      options.help = true;
      continue;
    }
    if (flags && ["--input", "-i", "--output", "-o"].includes(arg)) {
      const value = args[++i];
      if (!value) throw new Error(`${arg} \u306B\u30D5\u30A1\u30A4\u30EB\u3092\u6307\u5B9A\u3057\u3066\u304F\u3060\u3055\u3044`);
      const key = ["--input", "-i"].includes(arg) ? "input" : "output";
      if (options[key]) throw new Error(`${arg} \u306F1\u3064\u3060\u3051\u6307\u5B9A\u3057\u3066\u304F\u3060\u3055\u3044`);
      options[key] = value;
    } else if (flags && arg.startsWith("-")) {
      throw new Error(`\u672A\u5BFE\u5FDC\u306E\u30AA\u30D7\u30B7\u30E7\u30F3: ${arg}\uFF08--help \u3067\u4F7F\u3044\u65B9\u3092\u8868\u793A\uFF09`);
    } else {
      if (positional !== void 0) throw new Error("\u5165\u529B\u30D5\u30A1\u30A4\u30EB\u306F1\u3064\u3060\u3051\u6307\u5B9A\u3057\u3066\u304F\u3060\u3055\u3044");
      positional = arg;
    }
  }
  if (positional && options.input) throw new Error("\u5165\u529B\u30D5\u30A1\u30A4\u30EB\u306F1\u3064\u3060\u3051\u6307\u5B9A\u3057\u3066\u304F\u3060\u3055\u3044");
  options.input ??= positional;
  return options;
}
async function readKey() {
  const configured = deno.env.get("OPENAI_API_KEY");
  if (configured) return configured;
  const home = deno.env.get("HOME");
  if (!home) return "";
  try {
    const env = await deno.readTextFile(`${home}/.config/openai/api.env`);
    const match = env.match(/^\s*(?:export\s+)?OPENAI_API_KEY\s*=\s*(?:"([^"]*)"|'([^']*)'|([^#\r\n]*))/m);
    return (match?.[1] ?? match?.[2] ?? match?.[3] ?? "").trim();
  } catch (error) {
    if (error instanceof deno.errors.NotFound) return "";
    throw new Error("~/.config/openai/api.env \u3092\u8AAD\u307F\u8FBC\u3081\u307E\u305B\u3093", { cause: error });
  }
}
async function main() {
  const options = parseArgs(deno.args);
  if (options.help) {
    console.log(`Usage: format-markdown [file.md] [--output formatted.md]
       format-markdown --input file.md [--output formatted.md]
       cat file.md | format-markdown

AI (gpt-6.1-sol by default) selects line breaks by meaning.
A file argument is updated in place; --output saves to another file.
Requires Deno 2 and OPENAI_API_KEY. No Node.js, npm install, or server needed.`);
    return;
  }
  let markdown = "";
  if (options.input) markdown = await deno.readTextFile(options.input);
  else {
    if (deno.stdin.isTerminal()) throw new Error("\u30D5\u30A1\u30A4\u30EB\u3092\u6307\u5B9A\u3059\u308B\u304B\u3001\u6A19\u6E96\u5165\u529B\u304B\u3089Markdown\u3092\u6E21\u3057\u3066\u304F\u3060\u3055\u3044");
    for await (const chunk of deno.stdin.readable.pipeThrough(new TextDecoderStream())) {
      markdown += chunk;
      if (markdown.length > 1e5) throw new Error("\u5165\u529B\u306F100000\u6587\u5B57\u4EE5\u5185\u306B\u3057\u3066\u304F\u3060\u3055\u3044");
    }
  }
  const formatted = await formatOpenAIMarkdown(markdown, {
    apiKey: await readKey(),
    model: deno.env.get("MARKDOWN_FORMAT_AI_MODEL")
  });
  const output = options.output ?? options.input;
  if (output) await deno.writeTextFile(output, formatted);
  else {
    const bytes = new TextEncoder().encode(formatted);
    let offset = 0;
    while (offset < bytes.length) offset += await deno.stdout.write(bytes.subarray(offset));
  }
}
try {
  await main();
} catch (error) {
  const message = error instanceof Error && ["Error", "AIFormattingValidationError"].includes(error.name) ? error.message : "Markdown\u6574\u5F62\u306B\u5931\u6557\u3057\u307E\u3057\u305F\u3002\u5165\u529B\u30FB\u8A8D\u8A3C\u30FB\u63A5\u7D9A\u3092\u78BA\u8A8D\u3057\u3066\u304F\u3060\u3055\u3044";
  console.error(message);
  deno.exitCode = 1;
}
