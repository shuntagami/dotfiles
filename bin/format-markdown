#!/usr/bin/env node
// AIでMarkdownを整形する。処理本体はvercel-functionsで一元管理する。
const { existsSync } = require('node:fs');
const { homedir } = require('node:os');
const { join } = require('node:path');
const { spawnSync } = require('node:child_process');
const { parseArgs } = require('node:util');

function main() {
  const { values, positionals } = parseArgs({
    allowPositionals: true,
    options: {
      input: { type: 'string', short: 'i' },
      output: { type: 'string', short: 'o' },
      url: { type: 'string' },
      help: { type: 'boolean', short: 'h' },
    },
  });
  if (values.help) {
    console.log(`Usage: format-markdown [file.md] [--output formatted.md]
       format-markdown --input file.md [--output formatted.md]
       cat file.md | format-markdown

AI (gpt-6.1-sol by default) selects line breaks by meaning.
A file argument is updated in place; --output saves to another file.
Without a file argument, reads stdin and writes stdout.
--url calls the formatting API instead of running locally.
Requires Node.js 22.13+ and ~/projects/vercel-functions (pnpm install).
VERCEL_FUNCTIONS_DIR can override the repository location.`);
    return;
  }
  if (positionals.length > 1 || (values.input && positionals.length > 0)) {
    throw new Error('入力ファイルは1つだけ指定してください');
  }
  const input = values.input ?? positionals[0];
  if (!input && process.stdin.isTTY) {
    throw new Error('ファイルを指定するか、標準入力からMarkdownを渡してください（--help で使い方を表示）');
  }
  const project = process.env.VERCEL_FUNCTIONS_DIR ?? join(homedir(), 'projects', 'vercel-functions');
  const script = join(project, 'scripts', 'format-markdown.mjs');
  if (!existsSync(script)) {
    throw new Error(`整形コマンドが見つかりません: ${script}（vercel-functionsを準備してください）`);
  }
  if (!process.env.OPENAI_API_KEY) {
    const keyFile = join(homedir(), '.config', 'openai', 'api.env');
    if (existsSync(keyFile)) {
      delete process.env.OPENAI_API_KEY;
      process.loadEnvFile(keyFile);
    }
  }
  const args = [script, '--mode', 'ai'];
  if (input) args.push('--input', input);
  const output = values.output ?? input;
  if (output) args.push('--output', output);
  if (values.url) args.push('--url', values.url);
  const result = spawnSync(process.execPath, args, { stdio: 'inherit' });
  if (result.error) throw result.error;
  process.exitCode = result.status ?? 1;
}

try {
  main();
} catch (error) {
  console.error(error instanceof Error ? error.message : 'Markdown整形に失敗しました');
  process.exitCode = 1;
}
