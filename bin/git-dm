#!/usr/bin/env bash
# git-dm [--dry-run] [--keep-worktrees] [--force-gone]   (usage: `git dm -h`)
#
# Delete the local branches that are finished with: merged into the default
# branch, or left behind with a gone upstream.
#
# A branch carrying commits the default branch does not have is KEPT and listed:
# a squash merge and an unmerged branch look identical from here, and only one
# of them is safe to drop. --force-gone deletes those too, once you have read
# the list.
#
# This replaces a one-line alias that could not express two things.
#
#   - `git branch` marks a branch checked out in ANOTHER worktree with "+ ",
#     the same way it marks the current one with "* ". The alias stripped only
#     the "*", so every worktree branch arrived at `git branch -d` as the
#     literal name "+ feat/x", and git answered "branch '+ feat/x' not found".
#     Names come from for-each-ref here, where there is no prefix to strip.
#
#   - A branch a worktree holds cannot be deleted while that worktree exists,
#     whatever its name. And a worktree is what the finished branch was FOR, so
#     a cleanup that cannot take the worktree with it cannot finish: every agent
#     worktree leaves a branch that no amount of re-running will remove.
#
# A third thing was wrong quietly: `git branch --merged` with no argument means
# merged into HEAD. The alias announced "merged into default branch" while
# deleting whatever was merged into the branch you happened to be standing on.
# The default branch is resolved and passed explicitly.
#
# `git worktree remove` DELETES A DIRECTORY, so it runs only for a worktree that
# holds nothing: no modified files and no untracked ones. Anything else is
# skipped with its path, because a path is what someone needs to go look.
#
# `git dm --help` prints git's man lookup rather than this header: git resolves
# --help itself for an external command. `git dm -h` reaches the script.

set -euo pipefail

dry_run=false
keep_worktrees=false
force_gone=false
for arg in "$@"; do
  case "${arg}" in
    --dry-run) dry_run=true ;;
    --keep-worktrees) keep_worktrees=true ;;
    --force-gone) force_gone=true ;;
    -h | --help)
      sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *)
      echo "git-dm: unknown option ${arg}" >&2
      exit 2
      ;;
  esac
done

say() { printf '%s\n' "$*"; }
run() { if [[ "${dry_run}" == true ]]; then say "    [dry-run] $*"; else "$@"; fi; }

current_branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
main_worktree="$(git worktree list --porcelain | sed -n '1s/^worktree //p')"
this_worktree="$(git rev-parse --show-toplevel)"

# Run even under --dry-run, and deliberately. Neither touches a branch or a
# worktree of yours: one updates remote-tracking refs, the other drops records
# for worktree directories that are already gone. Skipping them would leave the
# dry-run predicting from stale state -- and a dry-run that does not predict the
# real run is the one thing it must not be.
say "[dm] fetch + prune"
# Stopping here is the point: every decision below is about what the remote has
# taken, so out-of-date remote state is not a degraded answer, it is a wrong
# one. Said in our own words because `set -e` would otherwise end the run on
# git's message alone, which explains the fetch but not why that ends the
# cleanup.
if ! git fetch --prune; then
  echo "git-dm: could not fetch from origin, so what the remote has taken is unknown." >&2
  echo "git-dm: nothing was deleted." >&2
  exit 1
fi
git worktree prune

# Which branch is the default, asked of the REMOTE. refs/remotes/origin/HEAD is
# a local ref set at clone time and refreshed only by `git remote set-head`, so
# it can name a branch the remote stopped defaulting to years ago -- and here
# that ref decides what counts as merged, which decides what gets deleted.
# `|| true` because of `pipefail`: without it a failing ls-remote fails the whole
# pipeline, `set -e` ends the script on the assignment, and the message below --
# the one that says WHY nothing was deleted -- never gets to speak. git's own
# "does not appear to be a git repository" is about the fetch, not about this.
default_branch="$(git ls-remote --symref origin HEAD 2>/dev/null | sed -n 's@^ref: refs/heads/\(.*\)[[:space:]]HEAD$@\1@p' | head -1 || true)"
if [[ -z "${default_branch}" ]]; then
  echo "git-dm: cannot read origin's default branch (git ls-remote --symref origin HEAD)." >&2
  echo "git-dm: nothing is deleted without knowing what to compare against." >&2
  exit 1
fi

# Everything downstream compares against this one ref, resolved once. It exists
# after the fetch above, and if it somehow does not, that is a reason to stop
# rather than to guess.
compare_ref="refs/remotes/origin/${default_branch}"
if ! git show-ref --verify --quiet "${compare_ref}"; then
  echo "git-dm: ${compare_ref} is missing even after fetching." >&2
  exit 1
fi
say "[dm] default branch: ${default_branch}"

# branch -> worktree path, read from porcelain so a path with spaces survives.
worktree_of() {
  git worktree list --porcelain | awk -v want="refs/heads/$1" '
    /^worktree /{ path = substr($0, 10) }
    /^branch /  { if (substr($0, 8) == want) { print path; exit } }
  '
}

deleted=0
skipped=0
# A branch can be both merged AND upstream-gone, so it appears in both passes.
# In a real run the second pass no longer sees what the first one deleted, but a
# dry-run deletes nothing and would print it twice -- and a dry-run that does not
# predict the real run is worse than none.
handled=""

# Removes the worktree holding $1 when it is safe to, and says why when not.
# Returns 0 when the branch is now free to delete.
free_the_branch() {
  local branch="$1" worktree
  worktree="$(worktree_of "${branch}")"
  [[ -n "${worktree}" ]] || return 0

  if [[ "${worktree}" == "${main_worktree}" || "${worktree}" == "${this_worktree}" ]]; then
    say "  skip ${branch} -- checked out here (${worktree})"
    return 1
  fi
  if [[ "${keep_worktrees}" == true ]]; then
    say "  skip ${branch} -- held by worktree ${worktree} (--keep-worktrees)"
    return 1
  fi
  if [[ -n "$(git -C "${worktree}" status --porcelain 2>/dev/null)" ]]; then
    say "  skip ${branch} -- worktree has uncommitted or untracked files: ${worktree}"
    return 1
  fi

  say "  remove worktree ${worktree} (clean, held ${branch})"
  run git worktree remove "${worktree}" || {
    say "    could not remove it; leaving ${branch} alone"
    return 1
  }
  return 0
}

drop_branch() {
  local branch="$1" why="$2"
  [[ "${branch}" != "${default_branch}" ]] || return 0
  [[ "${branch}" != "${current_branch}" ]] || return 0
  case " ${handled} " in *" ${branch} "*) return 0 ;; esac
  handled="${handled} ${branch}"

  # Containment is checked HERE, against the default branch, and the delete is
  # then unconditional -- because `git branch -d` asks a different question.
  # With an upstream present it refuses unless the branch is merged into THAT,
  # so a branch whose remote ref was left 27 commits behind is refused even
  # though every one of its commits is already in main. Nothing can be lost by
  # deleting a branch the default branch fully contains, and that is the thing
  # worth verifying.
  #
  # A FAILED comparison is not an answer. Reading it as zero would turn "I could
  # not tell" into "fully merged, delete it quietly" -- the wrong direction for
  # a command that deletes. And it is asked before the worktree is touched, so a
  # branch that cannot be judged does not first lose its worktree.
  local ahead
  if ! ahead="$(git rev-list --count "${compare_ref}..refs/heads/${branch}" 2>/dev/null)"; then
    say "  skip ${branch} -- cannot compare it with ${default_branch}"
    skipped=$((skipped + 1))
    return 0
  fi

  # Decided BEFORE the worktree is touched. A branch this keeps must keep its
  # worktree too: removing the directory and then announcing the branch is being
  # kept would be the worst of both answers.
  if [[ "${ahead}" != "0" ]] && [[ "${force_gone}" != true ]]; then
    # Commits the default branch does not contain. Which means one of two
    # things, and nothing here can tell them apart: a squash merge left the work
    # upstream under a different SHA, or the branch was never merged at all.
    #
    # So it stops, and says what it is looking at. Deleting would cost the
    # branch ref AND -- for a branch a worktree holds -- that directory, on a
    # guess. `git reflog` is a way back, not a reason to go. Re-run with
    # --force-gone once you have read the list and recognised it.
    say "  keep ${branch} -- ${ahead} commit(s) not in ${default_branch}:"
    git --no-pager log --oneline --max-count=3 "${compare_ref}..refs/heads/${branch}" 2>/dev/null | sed 's/^/        /'
    say "       squash-merged, or never merged. --force-gone deletes it anyway."
    skipped=$((skipped + 1))
    return 0
  fi

  if ! free_the_branch "${branch}"; then
    skipped=$((skipped + 1))
    return 0
  fi

  if [[ "${ahead}" != "0" ]]; then
    say "  note ${branch} has ${ahead} commit(s) not in ${default_branch} (--force-gone):"
    git --no-pager log --oneline --max-count=3 "${compare_ref}..refs/heads/${branch}" 2>/dev/null | sed 's/^/        /'
  fi
  say "  delete ${branch} ${why}"
  if run git branch -D "${branch}"; then
    deleted=$((deleted + 1))
  else
    skipped=$((skipped + 1))
  fi
}

say "[dm] branches merged into ${default_branch}"
while IFS= read -r branch; do
  [[ -n "${branch}" ]] && drop_branch "${branch}" "(merged)"
done < <(git for-each-ref --format='%(refname:short)' --merged "${compare_ref}" refs/heads)

say "[dm] branches whose upstream is gone"
while IFS= read -r branch; do
  [[ -n "${branch}" ]] && drop_branch "${branch}" "(gone upstream)"
done < <(git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads | awk '$2=="[gone]" {print $1}')

say "[dm] ${deleted} deleted, ${skipped} skipped"
