#!/bin/zsh

emulate -L zsh
setopt ERR_EXIT NO_UNSET PIPE_FAIL

readonly DICT_HELPER_SOURCE="${0:A:h}/lib/dict-helper.m"
readonly DICT_HELPER_CACHE_DIR="$HOME/Library/Caches/com.shuntagami.dict"
readonly DICT_HELPER="$DICT_HELPER_CACHE_DIR/dict-helper"

usage() {
  cat <<'EOF'
macOSの日本語ユーザ辞書を操作します。

使い方:
  dict add <よみ> <変換語>
  dict list [検索語]
  dict remove <よみ> [変換語]

例:
  dict add きららざか 雲母坂
  dict list
  dict list きららざか
  dict remove きららざか 雲母坂

変換語を省略してremoveすると、同じよみの登録をすべて削除します。
EOF
}

die() {
  print -r -u2 -- "エラー: $1"
  exit "${2:-1}"
}

require_macos() {
  [[ "$(uname -s)" == "Darwin" ]] \
    || die "dictはmacOS専用です。"
}

validate_entry() {
  local reading="$1"
  local word="$2"

  [[ -n "$reading" && -n "$word" ]] \
    || die "よみと変換語は空にできません。" 2
  [[ "$reading" != *$'\n'* && "$reading" != *$'\r'* ]] \
    || die "よみに改行は使用できません。" 2
  [[ "$word" != *$'\n'* && "$word" != *$'\r'* ]] \
    || die "変換語に改行は使用できません。" 2
}

ensure_helper() {
  local pending_helper

  [[ -r "$DICT_HELPER_SOURCE" ]] \
    || die "辞書更新ヘルパーが見つかりません: $DICT_HELPER_SOURCE"

  if [[ ! -x "$DICT_HELPER" || "$DICT_HELPER_SOURCE" -nt "$DICT_HELPER" ]]; then
    /usr/bin/xcrun --find clang >/dev/null 2>&1 \
      || die "辞書更新ヘルパーの作成にはXcode Command Line Toolsが必要です。"
    /bin/mkdir -p "$DICT_HELPER_CACHE_DIR"
    pending_helper="${DICT_HELPER}.$$"

    if ! /usr/bin/xcrun clang \
      -fobjc-arc \
      -fblocks \
      -framework Foundation \
      -lsqlite3 \
      -o "$pending_helper" \
      "$DICT_HELPER_SOURCE"; then
      die "辞書更新ヘルパーを作成できませんでした。"
    fi
    /bin/mv -f "$pending_helper" "$DICT_HELPER"
  fi
}

add_entry() {
  (( $# == 2 )) || {
    usage >&2
    exit 2
  }

  local reading="$1"
  local word="$2"
  local already_registered

  validate_entry "$reading" "$word"

  # defaultsへの直接書き込みではTextReplacements.dbへ反映されない。
  # APIへ毎回送り、過去にdefaultsだけへ保存された語も修復する。
  ensure_helper
  already_registered="$("$DICT_HELPER" add "$reading" "$word")" \
    || die "macOSのユーザ辞書へ登録できませんでした。"

  if (( already_registered )); then
    print -r -- "登録済みの語をmacOSの辞書と同期しました: ${reading} → ${word}"
  else
    print -r -- "macOSの辞書に登録しました: ${reading} → ${word}"
  fi
}

list_entries() {
  (( $# <= 1 )) || {
    usage >&2
    exit 2
  }

  ensure_helper
  "$DICT_HELPER" list "$@" \
    || die "macOSのユーザ辞書を読み込めませんでした。"
}

remove_entries() {
  (( $# == 1 || $# == 2 )) || {
    usage >&2
    exit 2
  }

  local reading="$1"
  local word="${2:-}"
  local removed
  local helper_status

  [[ -n "$reading" ]] || die "よみは空にできません。" 2

  ensure_helper
  removed="$("$DICT_HELPER" remove "$@")" || {
    helper_status=$?
    if (( helper_status == 4 )); then
      if [[ -n "$word" ]]; then
        die "登録が見つかりません: ${reading} → ${word}"
      else
        die "「${reading}」の登録が見つかりません。"
      fi
    fi
    die "macOSのユーザ辞書から削除できませんでした。"
  }

  if [[ -n "$word" ]]; then
    print -r -- "削除しました: ${reading} → ${word}"
  else
    print -r -- "「${reading}」の登録を${removed}件削除しました。"
  fi
}

require_macos

command_name="${1:-help}"
(( $# == 0 )) || shift

case "$command_name" in
  add)
    add_entry "$@"
    ;;
  list|ls)
    list_entries "$@"
    ;;
  remove|rm)
    remove_entries "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    print -r -u2 -- "不明なサブコマンドです: ${command_name}"
    usage >&2
    exit 2
    ;;
esac
