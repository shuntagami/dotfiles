#!/usr/bin/env node

const childProcess = require('child_process');
const crypto = require('crypto');
const fs = require('fs');
const os = require('os');
const path = require('path');

const HELP = `Upload an HTML file to Netlify and print the public URL

Usage:
  upload_html --site <name-or-id> path/to/report.html
  upload_html --site-name <new-name> path/to/report.html
  upload_html --anonymous path/to/report.html

Existing site:
  upload_html --site launch-report path/to/report.html

New site:
  upload_html --site-name launch-report path/to/report.html

  A random suffix is always appended to new site names:
    launch-report-01234567

  Run netlify login once before using either mode.
  The target must be specified explicitly. The current directory's
  .netlify/state.json is ignored.

Anonymous mode:
  upload_html --anonymous path/to/report.html

  This does not need login, but Netlify returns a temporary password-protected URL.
`;

function parseArgs(argv) {
  const options = {
    anonymous: false,
    siteId: '',
    siteName: '',
    auth: '',
    help: false,
    file: '',
  };

  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    if (arg === '-h' || arg === '--help') {
      options.help = true;
    } else if (arg === '--anonymous') {
      options.anonymous = true;
    } else if (arg === '--site') {
      options.siteId = argv[++i] || '';
    } else if (arg === '--site-name') {
      options.siteName = argv[++i] || '';
    } else if (arg === '--auth') {
      options.auth = argv[++i] || '';
    } else if (!options.file) {
      options.file = arg;
    } else {
      throw new Error(`Unexpected argument: ${arg}`);
    }
  }

  if (options.siteId && options.siteName) {
    throw new Error('Use either --site or --site-name, not both.');
  }
  if (options.anonymous && (options.siteId || options.siteName)) {
    throw new Error('--anonymous cannot be combined with --site or --site-name.');
  }

  return options;
}

function requireHtmlFile(filePath) {
  if (!fs.existsSync(filePath)) {
    throw new Error(`File not found: ${filePath}`);
  }
  const stat = fs.statSync(filePath);
  if (!stat.isFile()) {
    throw new Error(`Not a file: ${filePath}`);
  }
  if (!/\.(html|htm)$/i.test(filePath)) {
    throw new Error(`Expected an .html or .htm file: ${filePath}`);
  }
}

function extractJson(stdout) {
  const trimmed = stdout.trim();
  const start = trimmed.indexOf('{');
  if (start === -1) {
    throw new Error('Netlify did not return JSON output.');
  }
  return JSON.parse(trimmed.slice(start));
}

function preferHttps(url) {
  return typeof url === 'string' ? url.replace(/^http:\/\//, 'https://') : '';
}

function withRandomSuffix(siteName) {
  const suffix = crypto.randomBytes(4).toString('hex');
  const maxBaseLength = 63 - suffix.length - 1;
  const base = siteName.trim().slice(0, maxBaseLength).replace(/-+$/, '');
  if (!base) {
    throw new Error('Site name must contain at least one non-hyphen character.');
  }
  return `${base}-${suffix}`;
}

function setupHint() {
  return [
    '',
    'Setup:',
    '  1. Install: brew install netlify-cli',
    '  2. Run: netlify login',
    '  3. Existing site: upload_html --site <name-or-id> report.html',
    '     New site:      upload_html --site-name <new-name> report.html',
    '',
    'The target can also be set with UPLOAD_HTML_NETLIFY_SITE_ID,',
    'NETLIFY_SITE_ID, UPLOAD_HTML_NETLIFY_SITE_NAME, or NETLIFY_SITE_NAME.',
  ].join('\n');
}

(async () => {
  let options;
  try {
    options = parseArgs(process.argv.slice(2));
  } catch (error) {
    console.error(error.message);
    process.exit(1);
  }

  if (options.help || !options.file) {
    process.stdout.write(HELP);
    process.exit(options.help ? 0 : 1);
  }

  const filePath = path.resolve(options.file);

  try {
    requireHtmlFile(filePath);
  } catch (error) {
    console.error(error.message);
    process.exit(1);
  }

  const siteId =
    options.siteId ||
    process.env.UPLOAD_HTML_NETLIFY_SITE_ID ||
    process.env.NETLIFY_SITE_ID ||
    '';
  const requestedSiteName =
    options.siteName ||
    process.env.UPLOAD_HTML_NETLIFY_SITE_NAME ||
    process.env.NETLIFY_SITE_NAME ||
    '';
  const auth = options.auth || process.env.NETLIFY_AUTH_TOKEN || '';

  if (!options.anonymous && !siteId && !requestedSiteName) {
    console.error(
      'Specify an existing site with --site, or a new site with --site-name.',
    );
    process.stderr.write(setupHint() + '\n');
    process.exit(1);
  }

  let siteName = '';
  if (requestedSiteName) {
    try {
      siteName = withRandomSuffix(requestedSiteName);
    } catch (error) {
      console.error(error.message);
      process.exit(1);
    }
  }

  const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'upload_html.'));
  fs.copyFileSync(filePath, path.join(tmpDir, 'index.html'));

  try {
    const args = [
      'deploy',
      '--dir',
      tmpDir,
      '--no-build',
      '--json',
    ];

    if (options.anonymous) {
      args.push('--allow-anonymous');
    } else {
      args.push('--prod');
      if (siteId) {
        args.push('--site', siteId);
      } else {
        args.push('--site-name', siteName);
      }
      if (auth) args.push('--auth', auth);
    }

    const result = childProcess.spawnSync('netlify', args, {
      cwd: tmpDir,
      encoding: 'utf8',
    });

    if (result.error) {
      throw new Error(`Failed to run netlify: ${result.error.message}`);
    }

    if (result.status !== 0) {
      process.stderr.write(
        result.stderr || result.stdout || 'Netlify deploy failed.\n',
      );
      if (!options.anonymous) process.stderr.write(setupHint() + '\n');
      process.exit(result.status || 1);
    }

    const output = extractJson(result.stdout);
    const url = preferHttps(
      output.url ||
        output.ssl_url ||
        output.deploy_ssl_url ||
        output.deploy_url ||
        output.site_url,
    );
    if (!url) {
      console.error(
        'Netlify deploy succeeded, but no URL was found in the response.',
      );
      process.exit(1);
    }

    if (options.anonymous && output.password) {
      console.error(`Password: ${output.password}`);
      if (output.claim_url) console.error(`Claim URL: ${output.claim_url}`);
    }
    process.stdout.write(`${url}\n`);
  } catch (error) {
    console.error(error.message);
    process.exit(1);
  } finally {
    fs.rmSync(tmpDir, { recursive: true, force: true });
  }
})();
