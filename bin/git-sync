#!/usr/bin/env bash
# git sync [-C <repo>] : best-effort, non-disruptive fetch + ff-pull of the
#                        default branch, then merge the fresh tip into every
#                        other linked worktree's branch (no history rewrite,
#                        so no force-push is ever needed).
#
# Mirrors the safety conditions bin/git already uses for its worktree-add
# pre-fetch: best-effort, never disruptive. Skipped silently (never blocks,
# never leaves a repo mid-operation) when there's no remote, we're offline,
# a worktree has uncommitted changes to TRACKED files, or the merge
# can't be done cleanly. Untracked files don't gate anything here -
# `merge` already refuses safely on their own in the one
# case that actually matters (an untracked file the sync would overwrite),
# so pre-blocking on them too would just make a stray scratch file in the
# worktree (a seed script, a .temp/ dir) silently stall every sync forever.
# A merge conflict aborts the merge and is logged (no desktop notification:
# it repeated every interval for the same branch), not left half-done.
#
# Usage: git sync [-C <repo>]

set -uo pipefail

repo="$PWD"
if [[ "${1:-}" == "-C" ]]; then
  repo="${2:-$PWD}"
fi

cd "$repo" 2>/dev/null || { echo "[git sync] no such repo: $repo" >&2; exit 1; }
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "[git sync] not a git repo: $repo" >&2; exit 1; }

main_worktree=$(git worktree list --porcelain | awk '/^worktree /{print $2; exit}')
repo_name=$(basename "$main_worktree")

default_branch=$(git -C "$main_worktree" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@') || true
if [[ -z "$default_branch" ]]; then
  for b in main master; do
    if git -C "$main_worktree" rev-parse --verify --quiet "$b" >/dev/null 2>&1; then
      default_branch="$b"
      break
    fi
  done
fi
if [[ -z "$default_branch" ]]; then
  echo "[git sync] $repo_name: could not determine default branch, skipping"
  exit 0
fi

if ! git -C "$main_worktree" fetch --prune origin >/dev/null 2>&1; then
  echo "[git sync] $repo_name: fetch failed (offline?), skipping"
  exit 0
fi

# ff-pull the main worktree if it's on the default branch. A dirty tree is
# fine: `merge --ff-only` itself refuses (without touching anything) only when
# the incoming commits would overwrite a locally modified file, so a stray
# local edit (e.g. a machine-local config) must not stall the pull forever.
main_branch=$(git -C "$main_worktree" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
if [[ "$main_branch" == "$default_branch" ]]; then
  before=$(git -C "$main_worktree" rev-parse HEAD)
  if git -C "$main_worktree" merge --ff-only "origin/$default_branch" >/dev/null 2>&1; then
    after=$(git -C "$main_worktree" rev-parse HEAD)
    [[ "$before" != "$after" ]] && echo "[git sync] $repo_name: $default_branch ${before:0:7} -> ${after:0:7}"
  else
    echo "[git sync] $repo_name: $default_branch can't fast-forward (diverged or conflicts with local changes), skipping"
  fi
fi

# Merge the fresh origin/<default> tip into every other linked worktree.
target="origin/$default_branch"
git -C "$main_worktree" rev-parse --verify --quiet "$target" >/dev/null 2>&1 || exit 0

while IFS= read -r wt; do
  [[ "$wt" == "$main_worktree" ]] && continue
  branch=$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)
  [[ "$branch" == "HEAD" || "$branch" == "$default_branch" ]] && continue

  if [[ -n "$(git -C "$wt" status --porcelain --untracked-files=no 2>/dev/null)" ]]; then
    echo "[git sync] $repo_name: $branch has uncommitted changes, skipping merge"
    continue
  fi
  if [[ -e "$(git -C "$wt" rev-parse --git-path rebase-merge 2>/dev/null)" || -e "$(git -C "$wt" rev-parse --git-path rebase-apply 2>/dev/null)" || -e "$(git -C "$wt" rev-parse --git-path MERGE_HEAD 2>/dev/null)" ]]; then
    echo "[git sync] $repo_name: $branch already mid-rebase/merge, skipping"
    continue
  fi
  if git -C "$wt" merge-base --is-ancestor "$target" "$branch" 2>/dev/null; then
    continue  # already up to date with target
  fi

  before=$(git -C "$wt" rev-parse HEAD)
  if git -C "$wt" merge --no-edit "$target" >/dev/null 2>&1; then
    after=$(git -C "$wt" rev-parse HEAD)
    echo "[git sync] $repo_name: $branch merged $default_branch (${before:0:7} -> ${after:0:7})"
  else
    git -C "$wt" merge --abort >/dev/null 2>&1 || true
    echo "[git sync] $repo_name: $branch CONFLICTS merging $default_branch — needs manual merge" >&2
  fi
done < <(git worktree list --porcelain | awk '/^worktree /{print $2}')
